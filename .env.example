# Copy to .env.local (for Next.js) and fill in. Never commit real values.

# Supabase — needed from Phase 1 (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=                # optional: lets the ownership test prove anon cannot read vcs

# Gemini — needed from Phase 0 (aistudio.google.com → Get API key)
GEMINI_API_KEY=
GEMINI_API_KEY_2=                 # optional fallback key, tried on 401/403/429
GEMINI_MODEL=                    # the free Flash model AI Studio shows for your key

# Tavily — needed from Phase 0 (app.tavily.com, free plan)
TAVILY_API_KEY=
TAVILY_MONTHLY_BUDGET=800

# Secrets you generate yourself, e.g.: openssl rand -hex 32
DIGEST_WEBHOOK_URL=               # optional: Slack/Discord incoming webhook for the post-cron digest
CRON_SECRET=
HUNTER_API_KEY=
